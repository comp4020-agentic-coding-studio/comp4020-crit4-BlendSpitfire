---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Tap a Beat"
  description="A browser drum kit — tap the pads, or use the keyboard, to play."
>
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>Tap a Beat</h1>
    <p data-testid="play-prompt" class="prompt">
      Tap a piece of the kit to play<span class="key-hint">
        — or press <kbd>Q</kbd> <kbd>W</kbd> <kbd>E</kbd> <kbd>R</kbd>
        <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> <kbd>Z</kbd> <kbd>X</kbd></span
      >.
    </p>
    <div class="kit" role="group" aria-label="Drum kit, viewed from above">
      <button
        type="button"
        class="hit piece crash"
        data-drum="crash"
        data-key="q"
        aria-label="Crash cymbal (Q)"
      >
        <span class="icon ring"></span>
        <span class="label">Crash <kbd>Q</kbd></span>
      </button>

      <button
        type="button"
        class="hit piece hi-tom"
        data-drum="hi-tom"
        data-key="w"
        aria-label="Hi tom (W)"
      >
        <span class="icon disc-drum"></span>
        <span class="label">Hi tom <kbd>W</kbd></span>
      </button>

      <button
        type="button"
        class="hit piece mid-tom"
        data-drum="mid-tom"
        data-key="e"
        aria-label="Mid tom (E)"
      >
        <span class="icon disc-drum"></span>
        <span class="label">Mid tom <kbd>E</kbd></span>
      </button>

      <button
        type="button"
        class="hit piece ride"
        data-drum="ride"
        data-key="r"
        aria-label="Ride cymbal (R)"
      >
        <span class="icon ring"></span>
        <span class="label">Ride <kbd>R</kbd></span>
      </button>

      <button
        type="button"
        class="hit piece open-hihat"
        data-drum="hihat-open"
        data-key="a"
        aria-label="Hi-hat, open (A)"
      >
        <span class="icon disc-cymbal hihat-ring"></span>
        <span class="label">Open hi-hat <kbd>A</kbd></span>
      </button>

      <button
        type="button"
        class="hit piece closed-hihat"
        data-drum="hihat-closed"
        data-key="s"
        aria-label="Hi-hat, closed (S)"
      >
        <span class="icon disc-hihat-closed"></span>
        <span class="label">Closed hi-hat <kbd>S</kbd></span>
      </button>

      <button
        type="button"
        class="hit piece low-tom"
        data-drum="low-tom"
        data-key="d"
        aria-label="Low tom (D)"
      >
        <span class="icon disc-drum disc-drum-small"></span>
        <span class="label">Low tom <kbd>D</kbd></span>
      </button>

      <button
        type="button"
        class="hit piece snare"
        data-drum="snare"
        data-key="z"
        aria-label="Snare drum (Z)"
      >
        <span class="icon disc-drum disc-drum-large"></span>
        <span class="label">Snare <kbd>Z</kbd></span>
      </button>

      <button
        type="button"
        class="hit piece kick"
        data-drum="kick"
        data-key="x"
        aria-label="Kick drum (X)"
      >
        <span class="icon bar"></span>
        <span class="label">Kick <kbd>X</kbd></span>
      </button>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
